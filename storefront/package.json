    "@medusajs/types": "2.14.2",
    "@medusajs/ui": "^4.1.9",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.1.0",
    "@types/js-cookie": "^3.0.6",
    "algoliasearch": "^5.20.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.0",
