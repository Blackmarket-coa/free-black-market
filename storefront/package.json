{
  "name": "b2c-storefront",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "wait": "await-backend",
    "launcher": "launch-storefront",
    "dev": "pnpm run wait && pnpm run launcher dev",
    "build": "pnpm run wait && pnpm run launcher build",
    "start": "pnpm run launcher start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assert-env": "node ../scripts/assert-env.mjs --app=storefront",
    "qa:routes": "node qa/validate-static-routes.mjs",
    "qa:internal-links": "pnpm qa:routes",
    "release:check": "pnpm lint && pnpm typecheck && pnpm qa:internal-links"
  },
  "resolutions": {
    "glob": ">=10.5.0",
    "qs": ">=6.14.2",
    "axios": ">=1.15.2",
    "@isaacs/brace-expansion": ">=5.0.1",
    "preact": ">=10.27.3",
    "next": "15.5.18",
    "picomatch": ">=4.0.4",
    "postcss": ">=8.5.10",
    "esbuild": ">=0.28.1"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "qs": ">=6.14.2",
      "axios": ">=1.15.2",
      "@isaacs/brace-expansion": ">=5.0.1",
      "preact": ">=10.27.3",
      "next": "15.5.18",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.10",
      "esbuild": ">=0.28.1",
      "zod": "4.2.0"
    }
  },
  "dependencies": {
