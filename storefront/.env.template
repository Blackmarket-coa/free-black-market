MEDUSA_BACKEND_URL=
# Backwards-compatible fallback used by some launchers/proxies
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_DEFAULT_REGION=pl

# ⚠️  SECURITY WARNING: Set real values before deploying to production!
# Generate REVALIDATE_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEXT_PUBLIC_STRIPE_KEY must be a Stripe publishable key (pk_test_... in non-prod, pk_live_... in prod).
# The app refuses to start in production if either matches a banned placeholder.
NEXT_PUBLIC_STRIPE_KEY=pk_test_replace_with_real_stripe_publishable_key
REVALIDATE_SECRET=CHANGE_ME_revalidate_secret_min_32_chars
NEXT_PUBLIC_SITE_NAME="Black Market Coalition"
NEXT_PUBLIC_SITE_DESCRIPTION="Black Market Coalition"
# Algolia search credentials (required for storefront search + filters)
NEXT_PUBLIC_ALGOLIA_ID=your_algolia_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_algolia_search_key
NEXT_PUBLIC_VENDOR_URL=https://vendor.freeblackmarket.com

# Matrix/Synapse (Blackout) chat — public Element Web base URL and server name.
# Used to embed Element and build room aliases (#vendor-<handle>:<server>).
# Auto-login tokens are delivered server-side via /store/chat.
NEXT_PUBLIC_MATRIX_ELEMENT_URL=
NEXT_PUBLIC_MATRIX_SERVER_NAME=

# Sentry error tracking. Set the server DSN to capture SSR / route-handler /
# edge errors, and the NEXT_PUBLIC_ DSN to capture browser errors (baked into
# the client bundle at build time). Leave blank to disable. Optional tuning:
# SENTRY_ENVIRONMENT / SENTRY_SAMPLE_RATE and their NEXT_PUBLIC_ equivalents.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_SAMPLE_RATE=0.1
# Source-map upload (readable stack traces). Set all three at BUILD time to
# upload maps to Sentry; leave unset to skip upload (the build still succeeds).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- Native app shell (mobile/) ---
# HMAC secret for the buy-on-web cart handoff (POST/GET
# /api/native/checkout-handoff). Unset = the handoff surface is disabled
# (fail-closed) and the in-app button opens checkout without transferring
# the cart. Generate with: openssl rand -hex 32
NATIVE_HANDOFF_SECRET=
# Set to "true" to have the shell register for push notifications on
# launch (tokens are forwarded to the backend device registry at
# /store/native/push-tokens — see src/lib/native/push-notifications.ts).
NEXT_PUBLIC_NATIVE_PUSH=
# Android App Links / iOS Universal Links (both optional; the fbm://
# scheme works without them). Unset = the /.well-known routes 404.
# Release signing cert SHA-256 fingerprint(s), comma-separated, in
# keytool's AA:BB:… form:
NATIVE_ANDROID_CERT_SHA256=
# Apple team id + bundle id, e.g. AB12CD34EF.co.bmc.freeblackmarket:
NATIVE_APPLE_APP_ID=
