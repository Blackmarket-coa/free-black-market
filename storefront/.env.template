MEDUSA_BACKEND_URL=
# Backwards-compatible fallback used by some launchers/proxies
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_DEFAULT_REGION=pl

# ⚠️  SECURITY WARNING: Set real values before deploying to production!
# Generate REVALIDATE_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEXT_PUBLIC_STRIPE_KEY must be a Stripe publishable key (pk_test_... in non-prod, pk_live_... in prod).
# The app refuses to start in production if either matches a banned placeholder.
NEXT_PUBLIC_STRIPE_KEY=pk_test_replace_with_real_stripe_publishable_key
REVALIDATE_SECRET=CHANGE_ME_revalidate_secret_min_32_chars
NEXT_PUBLIC_SITE_NAME="Black Market Coalition"
NEXT_PUBLIC_SITE_DESCRIPTION="Black Market Coalition"
# Algolia search credentials (required for storefront search + filters)
NEXT_PUBLIC_ALGOLIA_ID=your_algolia_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_algolia_search_key
NEXT_PUBLIC_VENDOR_URL=https://vendor.freeblackmarket.com
