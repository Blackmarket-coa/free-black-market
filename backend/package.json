{
  "name": "medusa-starter-default",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "qs": ">=6.14.2",
      "jws": ">=3.2.3",
      "axios": ">=1.18.0",
      "@isaacs/brace-expansion": ">=5.0.1",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.3.0",
      "@remix-run/router": ">=1.23.2",
      "fast-xml-parser": ">=5.3.6",
      "@medusajs/core-flows": "2.14.2",
      "@medusajs/orchestration": "2.14.2",
      "@medusajs/workflows-sdk": "2.14.2",
      "lodash": ">=4.18.0",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.18",
      "@grpc/grpc-js": ">=1.14.4",
      "esbuild": ">=0.28.1",
      "form-data": ">=4.0.6",
      "vite": "^6.4.3",
      "@mikro-orm/core": "6.6.14",
      "@mikro-orm/cli": "6.6.14",
      "@mikro-orm/knex": "6.6.14",
      "@mikro-orm/migrations": "6.6.14",
      "@mikro-orm/postgresql": "6.6.14",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "immutable": ">=5.1.8",
      "minimatch@3": "^3.1.3",
      "minimatch@10": "^10.2.1",
      "multer": ">=2.2.0",
      "nodemailer": ">=9.0.1",
      "path-to-regexp@0": "^0.1.13",
      "path-to-regexp@8": "^8.4.0",
      "protobufjs": ">=8.4.1",
      "rollup": ">=4.59.0",
      "zod": "4.2.0"
    }
  },
  "scripts": {
    "postinstall": "node scripts/patch-mercurjs.js || true; node scripts/patch-mikro-orm.js || true",
    "build": "medusa build",
    "ib": "init-backend",
    "start": "node scripts/railway-start.js",
    "start:simple": "medusa db:migrate --execute-safe-links && init-backend && cd .medusa/server && medusa start",
    "dev": "medusa develop",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:if-needed": "node scripts/conditional-seed.js",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "assert-env": "node ../scripts/assert-env.mjs --app=backend",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=5120' jest --silent=false --maxWorkers=1 --workerIdleMemoryLimit=1G --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --coverage --coverageProvider=v8",
    "test:unit:ci": "npm run test:unit && node ./scripts/ensure-coverage.js",
    "test:posture-a": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit --testPathPattern=posture-a-invariants"
  },
  "dependencies": {
    "@bmc/restaurant-marketplace": "file:./restaurant-marketplace",
    "@medusajs/admin-sdk": "2.14.2",
    "@sentry/node": "^10.53.1",
    "@medusajs/cart": "2.14.2",
    "@medusajs/cli": "2.14.2",
    "@medusajs/core-flows": "2.14.2",
    "@medusajs/framework": "2.14.2",
    "@medusajs/icons": "2.14.2",
    "@medusajs/js-sdk": "2.14.2",
    "@medusajs/order": "2.14.2",
    "@medusajs/product": "2.14.2",
    "@medusajs/ui": "4.1.9",
    "@medusajs/utils": "2.14.2",
    "@mercurjs/b2c-core": "^1.4.5",
    "@mercurjs/commission": "^1.4.5",
    "@mercurjs/framework": "^1.4.5",
    "@mercurjs/payment-stripe-connect": "^1.4.5",
    "@mercurjs/reviews": "^1.4.5",
    "@mikro-orm/core": "6.6.14",
    "@mikro-orm/knex": "6.6.14",
    "@mikro-orm/migrations": "6.6.14",
    "@mikro-orm/postgresql": "6.6.14",
    "@octokit/auth-app": "6.1.4",
    "@octokit/rest": "19.0.13",
    "@react-email/components": "^1.0.3",
    "@stellar/stellar-sdk": "^13.1.0",
    "@tanstack/react-query": "5.64.2",
    "@types/bcryptjs": "^3.0.0",
    "@woocommerce/woocommerce-rest-api": "^1.0.2",
    "algoliasearch": "^5.44.0",
    "awilix": "^8.0.1",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "json-rpc-2.0": "^1.7.1",
    "jsonwebtoken": "^9.0.3",
    "medusajs-launch-utils": "^0.0.18",
    "minio": "^8.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "redis": "^5.10.0",
    "resend": "^6.6.0",
    "scrypt-kdf": "^2.0.1",
    "stripe": "^17.7.0",
    "ulid": "^2.3.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@graphql-codegen/visitor-plugin-common": "^6.2.2",
    "@medusajs/medusa": "2.14.2",
    "@medusajs/test-utils": "2.14.2",
    "@mikro-orm/cli": "6.6.10",
    "@swc/core": "1.15.7",
    "@swc/jest": "^0.2.36",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "bcrypt": "^6.0.0",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "6.30.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.61.0",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22"
  }
}
