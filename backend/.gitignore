# mikro-orm writes per-run schema snapshots into each module's
# migrations/ directory when `pnpm test:integration:http` or
# `medusa db:migrate` runs against a local/ephemeral DB. They're
# per-run artifacts (filename contains the transient DB name, which
# may use hyphens or underscores), not part of the migration graph.
src/modules/*/migrations/.snapshot-*.json

backend/package-lock.json

# Local-only env for running the integration suite against an ephemeral DB.
.env.test
