# =============================================================================
# FreeBlackMarket.com Backend Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in the values.
# For production deployments, set these as environment variables in Railway.
#
# Documentation: https://docs.medusajs.com/learn/configurations/environment-variables
# =============================================================================

# =============================================================================
# 🔴 REQUIRED - Application will not start without these
# =============================================================================

# PostgreSQL Database Connection
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost/mercurjs

# Security Secrets (CHANGE THESE IN PRODUCTION!)
# Generate secure values with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ⚠️  MUST be at least 32 characters. App will CRASH in production with default values!
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars_use_crypto_randomBytes
COOKIE_SECRET=CHANGE_ME_cookie_secret_min_32_chars_use_crypto_randomBytes

# =============================================================================
# 🟡 CORS CONFIGURATION - Required for frontend access
# =============================================================================

# Storefront URLs (comma-separated, no trailing slashes)
STORE_CORS=http://localhost:8000,http://localhost:3000,https://freeblackmarket.com,https://docs.medusajs.com

# Admin Panel URLs
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://admin.freeblackmarket.com,https://docs.medusajs.com

# Vendor Panel URLs
VENDOR_CORS=http://localhost:7000,http://localhost:7001,https://vendor.freeblackmarket.com,https://docs.medusajs.com

# Authentication URLs (usually includes all frontends)
AUTH_CORS=http://localhost:5173,http://localhost:7000,http://localhost:7001,http://localhost:9000,https://freeblackmarket.com,https://admin.freeblackmarket.com,https://vendor.freeblackmarket.com,https://docs.medusajs.com

# Vendor Panel URL (auto-added to STORE_CORS if set)
# VENDOR_PANEL_URL=https://vendor.freeblackmarket.com

# =============================================================================
# 🟢 OPTIONAL - Services enabled when configured
# =============================================================================

# Redis (Event Bus, Workflow Engine, Rate Limiting)
# Recommended for production. Falls back to in-memory if not set.
# REDIS_URL=redis://localhost:6379

# Stripe Payments
# STRIPE_API_KEY=sk_test_your_secret_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Printful (Print-on-Demand Fulfillment)
# PRINTFUL_API_KEY=pf_your_api_key_here
# PRINTFUL_API_TOKEN=pf_your_api_key_here
# PRINTFUL_TOKEN=pf_your_api_key_here
# PRINTFUL_WEBHOOK_SECRET=your_webhook_secret_here
# PRINTFUL_STORE_ID=your_store_id_here

# Vendor store-credential encryption (WooCommerce / Odoo import)
# Dedicated key to encrypt vendor store credentials at rest. Falls back to
# JWT_SECRET with a startup warning if unset — set a unique value in production.
# WOO_ENCRYPTION_KEY=

# Outbound sales-channel credential encryption (Faire and later channels)
# Dedicated key to encrypt channel access tokens at rest. Falls back to
# JWT_SECRET with a one-time warning if unset. Set _PREVIOUS to the old value
# when rotating; both are tried for decryption.
# CHANNEL_CREDENTIAL_KEY=
# CHANNEL_CREDENTIAL_KEY_PREVIOUS=

# FBM Sites — vendor "My Website" tab
# Connect (embed) works with just STOREFRONT_URL/PUBLIC_BACKEND_URL. The vars
# below enable one-click Launch (FBM-hosted site); leave blank to keep Launch
# disabled (the panel hides it and the endpoint returns 501).
# STOREFRONT_URL=https://freeblackmarket.com
# PUBLIC_BACKEND_URL=https://api.freeblackmarket.com
# SITES_DOMAIN=sites.freeblackmarket.com
# GITHUB_TOKEN=
# GITHUB_ORG=Blackmarket-coa
# SITE_TEMPLATE_REPO=Blackmarket-coa/fbm-site-template
# SITE_DEPLOY_SECRET=
# PROVISIONING_TIMEOUT_MS=900000

# Reverse proxy: set to the number of trusted proxy hops (e.g. 1) or "true" when
# behind a load balancer so req.ip (used for rate limiting) reads X-Forwarded-For.
# Leave UNSET when directly exposed, or clients could spoof the header.
# TRUST_PROXY=1

# Email Service Configuration (choose ONE option below)

# Option 1: SMTP Email (FREE - Gmail, Outlook, etc.)
# Recommended for development and small deployments
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password-here
# SMTP_FROM=your-email@gmail.com

# Option 2: Resend Email Service (requires domain verification)
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Algolia Search
# ALGOLIA_APP_ID=your-application-id
# ALGOLIA_API_KEY=your-admin-api-key

# MinIO Object Storage (falls back to local file storage)
# MINIO_ENDPOINT=your-minio-endpoint
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET=medusa-media
# MINIO_PUBLIC_URL=https://bucket-production-xxxx.up.railway.app

# Stellar Blockchain (Hawala Settlement)
# STELLAR_SECRET_KEY=Syour56characterstellarsecretkey
# STELLAR_NETWORK=testnet

# External Notification Services
# Matrix/Synapse (Blackout) - Internal Messaging Platform
# FBM provisions a Matrix account per user and embeds Element with auto-login.
# MATRIX_HOMESERVER_URL is the internal Synapse base (same server as Blackout).
# MATRIX_SERVER_NAME must match the server_name in Blackout mxids (@user:server_name).
# MATRIX_ADMIN_TOKEN is a Synapse server-admin access token.
# Requires Synapse `login_via_existing_session.enabled: true` for auto-login.
# MATRIX_HOMESERVER_URL=http://localhost:8008
# MATRIX_PUBLIC_BASE_URL=https://chat.example.com
# MATRIX_SERVER_NAME=blackout.local
# MATRIX_ADMIN_TOKEN=syt_your_admin_access_token
# MATRIX_ELEMENT_URL=https://element.example.com

# Auth providers (src/lib/build-auth-module.ts). With none of these set the
# framework default (emailpass-only) applies.
# BACKEND_URL is this API's public base; it derives default OAuth callbacks.
# BACKEND_URL=https://api.freeblackmarket.com
# Google social login (sellers — Creator Commerce Slice C):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://api.freeblackmarket.com/auth/seller/google/callback

# Matrix OIDC login (MAS) — W2, consolidation D4. Customers sign in against the
# Blackout-hosted Matrix Authentication Service (the ecosystem's one IdP).
# DARK until ISSUER+CLIENT_ID+CLIENT_SECRET are set. The client id/secret are
# registered in the Blackout deploy's MAS client registry (MAS_FBM_CLIENT_* in
# blackout deploy/docker/blackout-backend/.env.example); the callback there
# must match MAS_OIDC_CALLBACK_URL (default:
# ${BACKEND_URL}/auth/customer/mas/callback) EXACTLY.
# Contract: docs/contracts/mas-identity-consumer.md. Customer actor only —
# seller OIDC is deferred (it would bypass vendor registration/approval).
# MAS_OIDC_ISSUER=https://matrix.theblackout.app/
# MAS_OIDC_CLIENT_ID=00000000000000000000000FBM
# MAS_OIDC_CLIENT_SECRET=
# MAS_OIDC_CALLBACK_URL=https://api.freeblackmarket.com/auth/customer/mas/callback
# Space-separated; default "openid profile" (profile carries preferred_username).
# MAS_OIDC_SCOPES=openid profile
# mxid assembly uses MATRIX_SERVER_NAME (above).

# Blackout integration (FreeBlackMarket <-> Blackout)
# FREEBLACKMARKET_WEBHOOK_SECRET: HMAC-SHA256 secret for signing outbound webhooks (§1-§3).
# FREEBLACKMARKET_API_KEY: bearer key Blackout uses to call FBM's commerce API (§5).
# Both are REQUIRED in production (boot fails without them); optional in dev/test.
# BLACKOUT_API_BASE: destination FBM posts webhooks to, e.g. https://api.theblackout.app
# FREEBLACKMARKET_BASE_URL: public base of FBM's commerce API.
# ENTITLEMENTS_SERVICE_TOKEN: static bearer Blackout uses to call the entitlements service (§4).
# ENTITLEMENTS_BASE_URL: public base of FBM's entitlements service.
# FREEBLACKMARKET_WEBHOOK_SECRET=fbm_whsec_change_me
# FREEBLACKMARKET_API_KEY=fbm_api_change_me
# FREEBLACKMARKET_BASE_URL=https://api.freeblackmarket.com
# BLACKOUT_API_BASE=https://api.theblackout.app
# ENTITLEMENTS_SERVICE_TOKEN=fbm_ent_change_me
# ENTITLEMENTS_BASE_URL=https://entitlements.freeblackmarket.com

# Apprise - Multi-platform notification service
# APPRISE_API_URL=https://apprise.example.com/notify

# Hermes AI Runtime (self-hosted endpoint)
# Used by /vendor/hermes/runtime chat mode.
# Transport options:
# - openai_compatible: appends /chat/completions to HERMES_CHAT_BASE_URL (default)
# - n8n_webhook: posts directly to HERMES_CHAT_BASE_URL (n8n worker/webhook URL)
# - railway_n8n_workers: alias for n8n_webhook for Railway n8n-with-workers template
# HERMES_CHAT_TRANSPORT=openai_compatible
# HERMES_CHAT_BASE_URL=http://127.0.0.1:11434/v1
# HERMES_CHAT_MODEL=NousResearch/Hermes-4.3-36B
# Optional if your runtime requires auth:
# HERMES_CHAT_API_KEY=
# Optional shared secret header for webhook mode (X-Hermes-Webhook-Secret):
# HERMES_CHAT_WEBHOOK_SECRET=
# Railway n8n-with-workers template:
# https://railway.com/deploy/n8n-with-workers
# Example webhook setup:
# HERMES_CHAT_TRANSPORT=railway_n8n_workers
# HERMES_CHAT_BASE_URL=https://<your-railway-n8n-domain>/webhook/hermes-chat

# =============================================================================
# 📊 OBSERVABILITY - Monitoring & Debugging
# =============================================================================

# OpenTelemetry (distributed tracing)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=freeblackmarket-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Sentry Error Tracking
# SENTRY_DSN=https://key@sentry.io/project
# SENTRY_ENVIRONMENT=development
# SENTRY_SAMPLE_RATE=0.1

# Logging Level: debug | info | warn | error
LOG_LEVEL=debug

# =============================================================================
# 🚀 FEATURE FLAGS
# =============================================================================

ENABLE_STELLAR_SETTLEMENT=false
ENABLE_STRIPE_ACH=false

# =============================================================================
# 🛒 BMC MARKETPLACE LAYER
# =============================================================================

# Blackout integration. Reuses BLACKOUT_API_BASE / BLACKOUT_CLIENT_ID /
# BLACKOUT_CLIENT_SECRET / BLACKOUT_WEBHOOK_SECRET (declared above). Setting
# this to 1 enables /v1/integrations/blackout/* routes and requires
# BLACKOUT_CLIENT_ID/SECRET to be set. After enabling, seed the first-party
# Blackout catalog so listings surface in Blackout's marketplace:
#   pnpm medusa exec ./src/scripts/seed-blackout-catalog.ts
FBM_BLACKOUT_INTEGRATION=0
# Optional: token TTL in seconds for Blackout client_credentials access tokens.
# FBM_BLACKOUT_TOKEN_TTL_SECONDS=3600

# Blackstar (physical fulfillment sibling) integration. Setting this to 1
# registers the `blackstar` fulfillment provider and enables the inbound
# /v1/integrations/blackstar/events webhook.
FBM_BLACKSTAR_INTEGRATION=0
# Outbound (FBM -> Blackstar): destination base URL and the signing secret —
# the same value Blackstar reads as FBM_WEBHOOK_SECRET. Both required for the
# emitter to enqueue anything; unset means the channel silently no-ops.
BLACKSTAR_API_BASE=
BLACKSTAR_WEBHOOK_SECRET=
# Inbound (Blackstar -> FBM): the secret Blackstar signs its lifecycle events
# with (its FBM_OUTBOUND_SECRET). Unset means the events webhook returns 503 —
# it never authenticates against an empty key. Timestamped HMAC both ways;
# signatures outside the tolerance window are rejected as replays.
BLACKSTAR_OUTBOUND_SECRET=
# BLACKSTAR_SIGNATURE_TOLERANCE_SECONDS=300
# Per-partner bridge credentials (issue with:
#   pnpm medusa exec ./src/scripts/blackstar-bridge-credential.ts issue "<label>")
# replace the global BLACKSTAR_OUTBOUND_SECRET above. Secrets are encrypted at
# rest with BRIDGE_CREDENTIAL_KEY (falls back to JWT_SECRET with a warning —
# set a dedicated key in production; _PREVIOUS enables key rotation).
# BRIDGE_CREDENTIAL_KEY=
# BRIDGE_CREDENTIAL_KEY_PREVIOUS=
# When 1, inbound events must carry X-FBM-Key-ID and the global
# BLACKSTAR_OUTBOUND_SECRET is never consulted again.
# BLACKSTAR_REQUIRE_KEY_ID=0
# Key id Blackstar issued this deployment (output of its
# `php artisan fbm:credential issue`), announced on outbound events.
# BLACKSTAR_EMIT_KEY_ID=

# Default revenue split percentages used by payout-breakdown when the
# active PayoutConfig leaves them unset. All values are 0-100.
# FBM_DEFAULT_REFERRAL_PERCENT=
# FBM_DEFAULT_PLUGIN_DEVELOPER_PERCENT=

# Default lifetime (days) for entitlements granted without an explicit
# duration. Empty / unset = perpetual.
# FBM_ENTITLEMENT_DEFAULT_DURATION_DAYS=

# Sprint A onboarding: 48-hour follow-up scheduling delay (ms). Default 48h.
# FBM_ONBOARDING_FOLLOWUP_DELAY_MS=172800000

# Public storefront URL builder (used by the launch wizard's share screen).
# PUBLIC_STOREFRONT_URL=https://freeblackmarket.com

# =============================================================================
# 🔌 CONNECT.JS COMMERCE EMBED NETWORK
# =============================================================================
# Per-vendor publishable keys (pk_live_…) authenticate connect.js embeds and
# are validated against each vendor's connect_domains origin allow-list. No
# global secret is required — keys are generated per vendor from the panel.
#
# Storefront base used to build embed checkout/booking deep links.
# STOREFRONT_URL=https://freeblackmarket.com
#
# Embed chat bridges to Blackout/Matrix when configured (see MATRIX_* above);
# BLACKOUT_BASE_URL is used to build the in-iframe chat widget URL. Falls back
# to emailing the vendor when Matrix is unavailable.
# BLACKOUT_BASE_URL=https://theblackout.app
#
# Post-purchase review-request emails (daily job). Off unless explicitly enabled.
# ENABLE_REVIEW_REQUESTS=false

# =============================================================================
# 🐛 BUG REPORTER - In-app "Report a bug" → creates GitHub issues
# =============================================================================
# When configured, users submitting the in-app bug report form will have
# issues opened in the repository below. Defaults to enabled when credentials
# are present; set BUG_REPORT_ENABLED=false to hide the UI and disable routes.

# Required when bug reporting is enabled
# GITHUB_ISSUE_REPO=blackmarket-coa/free-black-market

# Preferred: GitHub App credentials (scoped, rotating installation tokens)
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY= # PEM string (with \n) or base64-encoded PEM

# Fallback: Personal Access Token (less preferred — broader scope, no rotation)
# GITHUB_PAT=

# Optional feature flag (defaults to true)
# BUG_REPORT_ENABLED=true

# =============================================================================
# 🚂 RAILWAY DEPLOYMENT OPTIMIZATION
# =============================================================================

# Node.js Memory Configuration
# Adjust based on your Railway plan (512 for Hobby, 1024+ for Pro)
NODE_MEMORY_MB=512

# PostgreSQL SSL Configuration
# SSL is auto-detected for Railway (no manual configuration needed)
# Detected via: railway.app URL, railway.internal URL, sslmode=require, or RAILWAY_ENVIRONMENT

# PostgreSQL Connection Pool
# Maximum number of connections in the pool (default: 10)
# DB_POOL_MAX=10

# Startup Optimization
# Skip seeding on subsequent deployments (set to true after first successful seed)
SKIP_SEED=false
# Skip migrations if already run (use with caution)
SKIP_MIGRATIONS=false
# Force re-seed even if data exists
FORCE_SEED=false

# =============================================================================
# 🛠️  DEVELOPMENT ONLY
# =============================================================================

NODE_ENV=development
PORT=9000
MEDUSA_ADMIN_EMAIL=admin@yourmail.com
# Set to a strong password before booting. App refuses to start in production
# if MEDUSA_ADMIN_PASSWORD is empty or matches a banned placeholder.
MEDUSA_ADMIN_PASSWORD=

# =============================================================================
# 🌱 PLANT NETWORK (BMC) - Optional
# =============================================================================

# Hub/coop seller that owns the WHOLESALE customer tier. Used as the default
# tier owner when approving a wholesale application (POST
# /admin/wholesale-application/:id/approve) if no seller_id is passed in the body.
# HUB_SELLER_ID=sel_...

# Shipping-label provider for grower node fulfillment. Defaults to "noop" (no
# label purchased) when unset. A real provider (e.g. easypost/shippo/usps) must
# be implemented in src/modules/agriculture/label-provider.ts and its carrier
# credentials supplied before changing this.
# PLANT_LABEL_PROVIDER=noop

