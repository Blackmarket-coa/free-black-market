    {
      "parameters": {
        "jsCode": "const params = $json.tool_call.parameters;\nconst required = ['product_id'];\nconst optional = ['reason'];\nconst allowed = new Set([...required, ...optional]);\nconst errors = [];\n\nfor (const field of required) {\n  if (!(field in params)) errors.push(`Missing required parameter: ${field}`);\n}\n\nfor (const [key, value] of Object.entries(params)) {\n  if (!allowed.has(key)) {\n    errors.push(`Unexpected parameter: ${key}`);\n    continue;\n  }\n  if (typeof value !== 'string') {\n    errors.push(`Invalid type for ${key}: expected string, received ${typeof value}`);\n  }\n}\n\nconst c = $json.confirmation;\nif (!c.explicitIntentInCurrentThread) errors.push('Destructive action requires explicit intent in current thread');\nif (!c.impactSummarized) errors.push('Destructive action requires impact summary before execution');\nif (!c.explicitConfirmationTurn) errors.push('Destructive action requires explicit confirmation turn');\nif (c.scopeChangedAfterConfirmation && !c.reconfirmedAfterScopeChange) {\n  errors.push('Scope changed after confirmation; re-confirmation is required');\n}\n\nreturn [{ json: { ...$json, is_valid: errors.length === 0, errors } }];"
      },
