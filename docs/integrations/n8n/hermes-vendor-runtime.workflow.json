      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst errors = [];\n\nif (!body || typeof body !== 'object' || Array.isArray(body)) {\n  errors.push('Request body is required and must be a JSON object.');\n}\n\nconst toolCall = body?.tool_call;\nif (!toolCall || typeof toolCall !== 'object' || Array.isArray(toolCall)) {\n  errors.push('tool_call object is required.');\n}\n\nif (typeof toolCall?.action !== 'string' || toolCall.action.trim().length === 0) {\n  errors.push('tool_call.action must be a non-empty string.');\n}\n\nif (!toolCall?.parameters || typeof toolCall.parameters !== 'object' || Array.isArray(toolCall.parameters)) {\n  errors.push('tool_call.parameters must be an object.');\n}\n\nconst confirmationInput = body?.confirmation ?? {};\nconst confirmation = {\n  explicitIntentInCurrentThread: Boolean(confirmationInput.explicitIntentInCurrentThread),\n  impactSummarized: Boolean(confirmationInput.impactSummarized),\n  explicitConfirmationTurn: Boolean(confirmationInput.explicitConfirmationTurn),\n  scopeChangedAfterConfirmation: Boolean(confirmationInput.scopeChangedAfterConfirmation),\n  reconfirmedAfterScopeChange: Boolean(confirmationInput.reconfirmedAfterScopeChange)\n};\n\nconst isValid = errors.length === 0;\n\nreturn [{\n  json: {\n    is_valid: isValid,\n    errors,\n    tool_call: toolCall ?? null,\n    confirmation,\n    request_meta: {\n      source: body?.source ?? 'n8n-webhook',\n      received_at: new Date().toISOString()\n    }\n  }\n}];"
      },
