    {
      "parameters": {
        "jsCode": "const params = $json.tool_call.parameters;\nconst required = ['title', 'description', 'price', 'currency_code'];\nconst optional = ['category', 'inventory_quantity', 'sku'];\nconst allowed = new Set([...required, ...optional]);\nconst expectedTypes = {\n  title: 'string',\n  description: 'string',\n  price: 'number',\n  currency_code: 'string',\n  category: 'string',\n  inventory_quantity: 'number',\n  sku: 'string'\n};\nconst errors = [];\n\nfor (const field of required) {\n  if (!(field in params)) errors.push(`Missing required parameter: ${field}`);\n}\n\nfor (const [key, value] of Object.entries(params)) {\n  if (!allowed.has(key)) {\n    errors.push(`Unexpected parameter: ${key}`);\n    continue;\n  }\n  if (typeof value !== expectedTypes[key]) {\n    errors.push(`Invalid type for ${key}: expected ${expectedTypes[key]}, received ${typeof value}`);\n  }\n}\n\nreturn [{ json: { ...$json, is_valid: errors.length === 0, errors } }];"
      },
      "id": "Validate_Create_Product",
      "name": "Validate create_product",
      "type": "n8n-nodes-base.code",
