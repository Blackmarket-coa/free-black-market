# FBM backend (MedusaJS) — proxied under /api in dev
VITE_FBM_API_URL=http://localhost:9000

# Blackout (Matrix) web app base — reads/writes proxied through the FBM backend,
# never direct. Used to deep-link to Space state events (split-contract proofs)
# and the stream overlay page.
VITE_BLACKOUT_URL=https://theblackout.app

# This creator's vendor identifier + display name (local-dev shortcut; in
# production these come from the FBM vendor session).
VITE_CREATOR_ID=nova-strand
VITE_CREATOR_NAME=Nova Strand

# The creator's Blackout Space id (Matrix Space the hub mirrors).
VITE_CREATOR_SPACE_ID=!coalition:theblackout.app

# connect.js publishable key for the embedded storefront
VITE_CONNECT_PUBLISHABLE_KEY=pk_live_xxxx
