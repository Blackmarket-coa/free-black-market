# =============================================================================
# FreeBlackMarket - Production environment template (Fedora deployment)
# =============================================================================
#
# Copy to .env.production at the repo root and fill in real values:
#   cp .env.production.example .env.production
#
# This file is consumed by docker-compose.prod.yml and scripts/deploy-fedora.sh.
# DO NOT commit the resulting .env.production - it is gitignored.
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================


# -----------------------------------------------------------------------------
# Image registry (GHCR)
# -----------------------------------------------------------------------------
# Tag to deploy. Override with `bash scripts/deploy-fedora.sh sha-abc1234`.
IMAGE_TAG=latest
# Owner of the GHCR images. Leave default unless you forked the repo.
GHCR_OWNER=blackmarket-coa
# Username for `docker login ghcr.io` (your GitHub login).
GHCR_USERNAME=
# Personal access token with at least `read:packages` scope.
GHCR_TOKEN=


# -----------------------------------------------------------------------------
# Public hostnames (must match nginx vhost + TLS certs)
# -----------------------------------------------------------------------------
PUBLIC_STOREFRONT_HOST=freeblackmarket.com
PUBLIC_API_HOST=api.freeblackmarket.com
PUBLIC_ADMIN_HOST=admin.freeblackmarket.com
PUBLIC_VENDOR_HOST=vendor.freeblackmarket.com


# -----------------------------------------------------------------------------
# Postgres (in-compose, named volume postgres-data)
# -----------------------------------------------------------------------------
POSTGRES_USER=medusa
POSTGRES_PASSWORD=
POSTGRES_DB=medusa
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Redis (in-compose, named volume redis-data)
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379


# -----------------------------------------------------------------------------
# MinIO (in-compose, named volume minio-data)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=medusa-media
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101


# =============================================================================
# Backend (Medusa)
# =============================================================================
NODE_ENV=production
PORT=9000

# Connection strings for in-compose services (use service DNS names).
DATABASE_URL=postgres://medusa:CHANGE_ME@postgres:5432/medusa

# Security secrets - MUST be at least 32 characters, randomly generated.
JWT_SECRET=
COOKIE_SECRET=

# CORS - origins permitted to hit the backend.
STORE_CORS=https://freeblackmarket.com
ADMIN_CORS=https://admin.freeblackmarket.com
VENDOR_CORS=https://vendor.freeblackmarket.com
AUTH_CORS=https://freeblackmarket.com,https://admin.freeblackmarket.com,https://vendor.freeblackmarket.com

# Initial admin user (created on first boot). Change before production launch.
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

# MinIO credentials backend uses to upload product imagery.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
# Public URL the frontend uses to load uploaded files.
MINIO_PUBLIC_URL=https://media.freeblackmarket.com

# Logging
LOG_LEVEL=info

# Skip seeding once the database has been populated (cutover from Railway).
SKIP_SEED=true
SKIP_MIGRATIONS=false


# -----------------------------------------------------------------------------
# Backend integrations (fill what you actually use)
# -----------------------------------------------------------------------------
# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Outbound ACH payouts (customer withdrawals). Kept OFF until Stripe Connect /
# external-account payout destinations are provisioned. While false, the
# POST /store/hawala/withdraw route fails closed (503) and debits no balance —
# it never records a ledger debit without executing a real payout. Requires
# STRIPE_SECRET_KEY to be set as well.
ACH_PAYOUTS_ENABLED=false

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM=

# Matrix/Synapse (Blackout) chat — leave blank to disable. When
# MATRIX_HOMESERVER_URL is set, MATRIX_SERVER_NAME and MATRIX_ADMIN_TOKEN are required.
# Requires Synapse `login_via_existing_session.enabled: true` for Element auto-login.
MATRIX_HOMESERVER_URL=
MATRIX_PUBLIC_BASE_URL=
MATRIX_SERVER_NAME=
MATRIX_ADMIN_TOKEN=
MATRIX_ELEMENT_URL=

# Blackout integration (FreeBlackMarket <-> Blackout Creator Hub bridge).
# Outbound webhook emitter (membership sync, purchases, ledger) signs deliveries
# with FREEBLACKMARKET_WEBHOOK_SECRET and ships them to BLACKOUT_API_BASE. Both
# are required in production (loadConfig fails fast without them).
FREEBLACKMARKET_WEBHOOK_SECRET=
FREEBLACKMARKET_API_KEY=
BLACKOUT_API_BASE=
# Public Blackout web app origin (user-facing), used to build creator links
# such as the OBS stream overlay. Defaults to https://theblackout.app.
BLACKOUT_APP_URL=https://theblackout.app
# HS256 signing secret for the stream-overlay JWT. Leave blank to disable the
# overlay-url endpoint (it returns 503 rather than minting an unverifiable token).
BLACKOUT_OVERLAY_SECRET=

# Algolia (storefront search)
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_INDEX_NAME=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=0.1

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=freeblackmarket-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature flags
ENABLE_STELLAR_SETTLEMENT=false
ENABLE_STRIPE_ACH=false
FBM_BLACKOUT_INTEGRATION=0
FBM_BLACKSTAR_INTEGRATION=0
# Blackstar bridge (timestamped HMAC both directions; see backend/.env.template):
# BLACKSTAR_API_BASE=
# BLACKSTAR_WEBHOOK_SECRET=
# BLACKSTAR_OUTBOUND_SECRET=
# Per-partner bridge credentials (see backend/.env.template for details):
# BRIDGE_CREDENTIAL_KEY=
# BLACKSTAR_REQUIRE_KEY_ID=0
# BLACKSTAR_EMIT_KEY_ID=

# =============================================================================
# Stellar / USDC settlement bridge
# (Foundation milestone §5.1; see docs/runbooks/STELLAR_USDC_BRIDGE.md)
# Default config below targets testnet. Mainnet cutover requires:
#   1. Provisioning a fresh signer keypair in the secrets manager (do NOT
#      commit any secret here).
#   2. Switching STELLAR_NETWORK to "mainnet".
#   3. Pointing STELLAR_HORIZON_URL at a production Horizon endpoint.
#   4. Setting STELLAR_USDC_ISSUER to Circle's mainnet issuer
#      (GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN).
#   5. Funding the signer account with XLM for fees and a USDC trustline.
#   6. Running the smoke check in the runbook against testnet first.
# Until that cutover, ENABLE_STELLAR_SETTLEMENT stays false.
#
# Fail-fast guard: if ENABLE_STELLAR_SETTLEMENT=true in a production deploy,
# STELLAR_NETWORK MUST be "mainnet" and STELLAR_USDC_ISSUER MUST be set, or the
# service refuses to start (it will not silently anchor real value to testnet).
# =============================================================================
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon.stellar.org   # uncomment for mainnet
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# STELLAR_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN  # mainnet Circle USDC
# STELLAR_SIGNER_SECRET=  # NEVER commit; load from secrets manager only
# Dual-rail selector tuning (defaults applied if unset):
# STELLAR_DUAL_RAIL_MIN_AMOUNT=1.00       # below this, force Stripe-ACH
# STELLAR_RETRY_MAX_ATTEMPTS=3            # Horizon submission retry cap
# STELLAR_RETRY_BASE_DELAY_MS=250         # exponential backoff base


# =============================================================================
# Storefront (Next.js)
# =============================================================================
MEDUSA_BACKEND_URL=http://backend:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.freeblackmarket.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=https://freeblackmarket.com
NEXT_PUBLIC_DEFAULT_REGION=us
NEXT_PUBLIC_STRIPE_KEY=
REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_NAME="Black Market Coalition"
NEXT_PUBLIC_SITE_DESCRIPTION="Black Market Coalition"

# Capacitor / in-app webview embed allowlist per
# AGGRESSIVE_OPERATIONS_GUIDE.md §2.8 and §5.1. Comma-separated list
# of origins that are allowed to embed the storefront. The Blackout
# Capacitor wrapper passes its origin in X-FBM-Embed-Origin; only
# origins listed here get the relaxed frame-ancestors CSP.
# Example: capacitor://localhost,https://blackout.bmc.example
BLACKOUT_EMBED_ALLOWED_ORIGINS=
# Embed auth bootstrap (POST /api/auth/embed-bootstrap) is DISABLED by default
# and fails closed with 501 unless explicitly enabled. Only turn this on once
# the embedded webview delegated-auth flow is being used; the route still
# enforces the origin allowlist above and structural token sanity. Full
# cryptographic JWS verification of the Blackout token pins when Blackout
# publishes its signing key.
BLACKOUT_EMBED_ENABLED=false
NEXT_PUBLIC_ALGOLIA_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_VENDOR_URL=https://vendor.freeblackmarket.com


# =============================================================================
# FBM Sites — "commerce anywhere" (vendor "My Website" tab)
# =============================================================================
# Public base URL the embedded Connect SDK (connect.js) calls. Used to build the
# copy-paste snippet shown to vendors. Defaults to NEXT_PUBLIC_MEDUSA_BACKEND_URL.
PUBLIC_BACKEND_URL=https://api.freeblackmarket.com
# Public storefront origin that hosts /connect.js and the product pages.
STOREFRONT_URL=https://freeblackmarket.com
# Wildcard host launched vendor sites are served under: {handle}.${SITES_DOMAIN}
SITES_DOMAIN=sites.freeblackmarket.com
#
# --- Mode 2 (Launch) provisioning ---
# Leave these blank to disable one-click Launch: the panel falls back to
# Connect-only and POST /vendor/website/launch returns 501 (Not Configured).
# GitHub token (PAT or GitHub App token) with `repo` + `workflow` scope on the org.
GITHUB_TOKEN=
# GitHub org that owns the provisioned vendor-site repositories.
GITHUB_ORG=Blackmarket-coa
# Template repo (must be marked "Template repository") new sites are generated
# from. See templates/fbm-site-template/README.md.
SITE_TEMPLATE_REPO=Blackmarket-coa/fbm-site-template
#
# --- Deploy callback (auto-flip provisioning -> live) ---
# Shared HMAC secret for the POST /webhooks/site-deploy callback a launched
# site's deploy workflow sends when it goes live. Set the SAME value as an
# org-level `FBM_DEPLOY_SECRET` Actions secret on the launched-site repos.
# Leave blank to disable the webhook; the vendor panel still auto-detects the
# live site via a liveness probe + polling.
SITE_DEPLOY_SECRET=
# How long (ms) a launched site may sit in "provisioning" before the panel marks
# it "failed" so the vendor can retry. Optional; defaults to 900000 (15 min).
# PROVISIONING_TIMEOUT_MS=900000


# =============================================================================
# Vendor product imports (WooCommerce / Printful / Odoo)
# =============================================================================
# Dedicated key used to encrypt vendor store credentials (WooCommerce consumer
# key/secret, Odoo API keys) at rest. STRONGLY recommended: set a unique random
# value. If unset, the code falls back to JWT_SECRET and logs a warning — that
# couples two trust domains, so provide a dedicated key in production.
WOO_ENCRYPTION_KEY=
# Dedicated key used to encrypt outbound sales-channel access tokens (Faire and
# any later channel) at rest. Same posture as WOO_ENCRYPTION_KEY: falls back to
# JWT_SECRET with a one-time warning if unset. Set CHANNEL_CREDENTIAL_KEY_PREVIOUS
# to the old value when rotating — both are tried for decryption, so rotation
# does not need a flag day or a restart.
CHANNEL_CREDENTIAL_KEY=
CHANNEL_CREDENTIAL_KEY_PREVIOUS=
# Printful private token for the Printful import + fulfillment integration.
# Leave blank to disable Printful features.
PRINTFUL_API_KEY=


# =============================================================================
# Networking / proxy
# =============================================================================
# Set when the app runs behind a reverse proxy / load balancer so Express derives
# the real client IP from X-Forwarded-For for rate limiting. Use the number of
# trusted proxy hops (e.g. "1"), or "true". Leave UNSET when the app is directly
# exposed — otherwise clients could spoof X-Forwarded-For to evade per-IP limits.
# TRUST_PROXY=1


# =============================================================================
# Admin Panel (Vite)
# =============================================================================
VITE_MEDUSA_BASE=/
VITE_MEDUSA_STOREFRONT_URL=https://freeblackmarket.com
VITE_MEDUSA_BACKEND_URL=https://api.freeblackmarket.com


# =============================================================================
# Vendor Panel (Vite)
# =============================================================================
# (the same VITE_MEDUSA_* keys above are read by both panels at build time;
#  these were baked in at image-build time and should match the URLs above.)
VITE_TALK_JS_APP_ID=
VITE_DISABLE_SELLERS_REGISTRATION=false


# =============================================================================
# Service port overrides (kept loopback-only by docker-compose.prod.yml)
# =============================================================================
BACKEND_PORT=9000
STOREFRONT_PORT=3000
ADMIN_PANEL_PORT=7000
VENDOR_PANEL_PORT=7001
