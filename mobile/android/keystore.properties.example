# Copy to `keystore.properties` (same directory) to enable signed release
# builds. The real file is gitignored — it must never be committed.
#
#   cp keystore.properties.example keystore.properties
#
# In CI, write this file from secrets immediately before the release build
# and delete it afterwards; do not bake it into an image.
#
# `storeFile` is resolved relative to mobile/android/ when given as a
# relative path — prefer an absolute path outside the repo.

storeFile=/absolute/path/to/fbm-upload.jks
storePassword=CHANGE_ME_upload_keystore_password
keyAlias=fbm-upload
keyPassword=CHANGE_ME_upload_key_password
