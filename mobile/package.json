{
  "name": "@bmc/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "FBM mobile app - Capacitor shell around the Next.js storefront",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "version:set": "node scripts/set-version.mjs",
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "copy": "cap copy",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "build:android": "cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/device": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.0"
  }
}
