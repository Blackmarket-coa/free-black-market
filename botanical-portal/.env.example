# FBM backend (MedusaJS) — proxied under /api in dev
VITE_FBM_API_URL=http://localhost:9000

# Blackout (Matrix) base — reads/writes proxied through the FBM backend, never direct
VITE_BLACKOUT_URL=https://theblackout.app

# Operator type: "maker" (single producer) or "collective" (shared production house).
# In production this comes from the vendor session; the env var is a dev shortcut.
VITE_OPERATOR_TYPE=maker

# Links this portal to a BMC nursery node for ingredient sourcing — optional.
VITE_NURSERY_NODE_ID=
